{
  "name": "sudoku-solver-demo",
  "version": "1.0.0",
  "description": "Sudoku solver implementing basic solving techniques",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node app_src/index.ts",
    "start:api": "ts-node app_src/server/index.ts",
    "start:web": "ts-node app_src/server/index.ts",
    "build": "tsc",
    "run": "node dist/index.js",
    "lint": "eslint \"app_src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "format": "prettier --write \"app_src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "format:check": "prettier --check \"app_src/**/*.ts\" \"tests/**/*.ts\" \"tooling/**/*.ts\"",
    "test": "npm run test:component && cucumber-js --config tooling/cucumber.js",
    "test:component": "node --test -r ts-node/register tests/component/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=85 --test-coverage-functions=75 --test-coverage-include=app_src/PuzzleLoader.ts --test-coverage-include=app_src/SudokuSolver.ts --test-coverage-include=app_src/SudokuOrchestrator.ts --test-coverage-include=app_src/server/SudokuApiService.ts --test-coverage-include=app_src/server/validation.ts -r ts-node/register tests/component/*.test.ts",
    "test:mutation-trial": "ts-node tooling/mutation/coverage-mutation-trial.ts",
    "test:orchestration": "node --test -r ts-node/register tests/component/orchestration.contract.test.ts",
    "test:api": "ts-node tests/api/api.integration.ts",
    "openapi:lint": "redocly lint --config redocly.yaml docs/openapi.yaml",
    "test:openapi": "node --test -r ts-node/register tests/api/openapi.contract.test.ts",
    "verify:openapi": "npm run openapi:lint && npm run test:openapi",
    "benchmark": "ts-node tooling/performance/benchmark.ts"
  },
  "keywords": [
    "sudoku",
    "solver",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.3",
    "@cucumber/pretty-formatter": "^3.3.0",
    "@redocly/cli": "2.41.0",
    "@serenity-js/assertions": "^3.43.2",
    "@serenity-js/core": "^3.43.2",
    "@serenity-js/cucumber": "^3.43.2",
    "@serenity-js/serenity-bdd": "^3.43.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "ajv-formats": "3.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-backend": "5.19.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
